<h1 class="mb-4 text-center">Books</h1>

<form class="mb-4" action="/" method="get">
  <div class="input-group">
    <input type="text"
           class="form-control"
           name="books"
           placeholder="Search by title"
           value="${param.q}">
    <button class="btn btn-primary" type="submit">Search</button>
  </div>
</form>